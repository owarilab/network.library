            {
              "id": "obj_hud_canvas",
              "name": "HudCanvas",
              "enabled": true,
              "parentId": null,
              "children": [
                "obj_hud_hp",
                "obj_hud_potion"
              ],
              "components": [
                {
                  "type": "UICanvas",
                  "enabled": true,
                  "data": {
                    "referenceWidth": 640,
                    "referenceHeight": 360,
                    "sortOrder": 5
                  }
                },
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "hud.potion",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${db.mutable.party.hero.hp}",
                          "operator": "<",
                          "right": "${db.mutable.party.hero.maxHp}"
                        },
                        "action": {
                          "action": "sequence",
                          "steps": [
                            {
                              "action": "setGlobalVariable",
                              "variablePath": "db.mutable.party.hero.hp",
                              "op": "add",
                              "valueSource": "variable",
                              "valueVariablePath": "db.const.items.potion.heal"
                            },
                            {
                              "action": "fireEvent",
                              "eventId": "party.clamp"
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "party.clamp",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${db.mutable.party.hero.hp}",
                          "operator": ">",
                          "right": "${db.mutable.party.hero.maxHp}"
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "db.mutable.party.hero.hp",
                          "op": "set",
                          "valueSource": "variable",
                          "valueVariablePath": "db.mutable.party.hero.maxHp"
                        }
                      },
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${db.mutable.party.hero.hp}",
                          "operator": "<",
                          "right": 0
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "db.mutable.party.hero.hp",
                          "op": "set",
                          "valueSource": "literal",
                          "value": 0
                        }
                      }
                    ]
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "hazard.spike",
                    "action": "setGlobalVariable",
                    "variablePath": "db.mutable.party.hero.hp",
                    "op": "subtract",
                    "valueSource": "variable",
                    "valueVariablePath": "db.const.hazards.spike.damage"
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "hazard.spike",
                    "action": "fireEvent",
                    "eventId": "party.clamp"
                  }
                }
              ]
            },
