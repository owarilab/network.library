            {
              "id": "obj_check_enemy_defeat_battle_demo_1",
              "name": "Check Enemy Defeat",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_check_enemy_defeat",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.enemyHp}",
                          "operator": "<=",
                          "right": 0
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.battleLog",
                          "valueSource": "literal",
                          "value": "Enemy defeated. Battle won!",
                          "op": "set"
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "obj_use_potion_conditional_battle_demo_1",
              "name": "Use Potion Conditional",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_use_potion",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.potions}",
                          "operator": ">",
                          "right": 0
                        },
                        "action": {
                          "action": "fireEvent",
                          "eventId": "ev_use_potion_success"
                        }
                      }
                    ],
                    "defaultAction": {
                      "action": "setGlobalVariable",
                      "variablePath": "user.persistent.battleLog",
                      "valueSource": "literal",
                      "value": "No potion left.",
                      "op": "set"
                    }
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_use_potion_success",
                    "action": "setGlobalVariable",
                    "variablePath": "user.persistent.playerHp",
                    "valueSource": "variable",
                    "valueVariablePath": "user.persistent.healAmount",
                    "op": "add"
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_use_potion_success",
                    "action": "setGlobalVariable",
                    "variablePath": "user.persistent.potions",
                    "valueSource": "literal",
                    "value": 1,
                    "op": "subtract"
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_use_potion_success",
                    "action": "setGlobalVariable",
                    "variablePath": "user.persistent.battleLog",
                    "valueSource": "literal",
                    "value": "You used a potion.",
                    "op": "set"
                  }
                }
              ]
            },
            {
              "id": "obj_enemy_turn_conditional_battle_demo_1",
              "name": "Enemy Turn Conditional",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_enemy_turn",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.enemyHp}",
                          "operator": "<=",
                          "right": 0
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.battleLog",
                          "valueSource": "literal",
                          "value": "Enemy already defeated.",
                          "op": "set"
                        }
                      },
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.playerHp}",
                          "operator": "<=",
                          "right": 20
                        },
                        "action": {
                          "action": "fireEvent",
                          "eventId": "ev_enemy_finisher"
                        }
                      },
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.enemyHp}",
                          "operator": "<",
                          "right": 20
                        },
                        "action": {
                          "action": "fireEvent",
                          "eventId": "ev_enemy_desperate"
                        }
                      }
                    ],
                    "defaultAction": {
                      "action": "fireEvent",
                      "eventId": "ev_enemy_normal"
                    }
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_enemy_finisher",
                    "action": "setGlobalVariable",
                    "variablePath": "user.persistent.playerHp",
                    "valueSource": "variable",
                    "valueVariablePath": "user.persistent.enemyFinisherDamage",
                    "op": "subtract"
                  }
                },
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_enemy_finisher",
                    "action": "setGlobalVariable",
                    "variablePath": "user.persistent.battleLog",
                    "valueSource": "literal",
                    "value": "Enemy uses a heavy strike!",
                    "op": "set"
                  }
                },
