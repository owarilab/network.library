            {
              "id": "obj_conditional_logic_cond_min_1",
              "name": "Conditional Logic",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_run_conditional",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.hp}",
                          "operator": ">",
                          "right": 50
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.result",
                          "valueSource": "literal",
                          "value": "PASS: hp > 50",
                          "op": "set"
                        }
                      }
                    ],
                    "defaultAction": {
                      "action": "setGlobalVariable",
                      "variablePath": "user.persistent.result",
                      "valueSource": "literal",
                      "value": "FALLBACK: hp <= 50",
                      "op": "set"
                    }
                  }
                }
              ]
            }
