                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "=== Complex Scenario: RPG Battle AI ===",
                    "fontSize": 16,
                    "fontFamily": "monospace",
                    "fillColor": "#f0f0f0",
                    "textAlign": "left",
                    "textBaseline": "top"
                  }
                }
              ]
            },
            {
              "id": "obj_enemy_status",
              "name": "Enemy Status",
              "components": [
                {
                  "type": "Transform",
                  "enabled": true,
                  "data": {
                    "x": 100,
                    "y": 60,
                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "Enemy HP: ${user.persistent.enemyHp}/${user.persistent.enemyMaxHp}, Attack: ${user.persistent.enemyAttackPower}",
                    "fontSize": 12,
                    "fontFamily": "monospace",
                    "fillColor": "#ff8888",
                    "textAlign": "left",
                    "textBaseline": "top"
                  }
                }
              ]
            },
            {
              "id": "obj_player_status",
              "name": "Player Status",
              "components": [
                {
                  "type": "Transform",
                  "enabled": true,
                  "data": {
                    "x": 100,
                    "y": 90,
                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "Player HP: ${user.persistent.hp}/${user.persistent.maxHp}",
                    "fontSize": 12,
                    "fontFamily": "monospace",
                    "fillColor": "#88ff88",
                    "textAlign": "left",
                    "textBaseline": "top"
                  }
                }
              ]
            },
            {
              "id": "obj_ai_trigger",
              "name": "AI Decision Button",
              "components": [
                {
                  "type": "Transform",
                  "enabled": true,
                  "data": {
                    "x": 100,
                    "y": 140,
                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Rectangle",
                  "enabled": true,
                  "data": {
                    "width": 250,
                    "height": 30,
                    "fillColor": "#334455",
                    "strokeColor": "#ff8888",
                    "lineWidth": 2
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "Click: Enemy AI Decision",
                    "fontSize": 12,
                    "fontFamily": "monospace",
                    "fillColor": "#ffffff",
                    "textAlign": "left",
                    "textBaseline": "middle"
                  }
                },
                {
                  "type": "Trigger",
                  "enabled": true,
                  "data": {
                    "triggerKey": "trigger_ai_decision",
                    "triggerOn": "click",
                    "eventId": "event_ai_decision",
                    "once": false
                  }
                }
              ]
            },
            {
              "id": "obj_battle_action_result",
              "name": "Battle Action Result",
              "components": [
                {
                  "type": "Transform",
                  "enabled": true,
                  "data": {
                    "x": 400,
                    "y": 140,
                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "AI Action: ${user.persistent.battleAction}",
                    "fontSize": 12,
                    "fontFamily": "monospace",
                    "fillColor": "#ffff88",
                    "textAlign": "left",
                    "textBaseline": "middle"
                  }
                }
              ]
            },
            {
              "id": "obj_ai_conditional",
              "name": "AI Decision Conditional",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "event_ai_decision",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.enemyHp}",
                          "operator": "<",
                          "right": 15
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.battleAction",
                          "valueSource": "literal",
                          "value": "FLEE (HP critical)",
                          "op": "set"
                        }
                      },
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.hp}",
                          "operator": ">",
                          "right": 80
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.battleAction",
                          "valueSource": "literal",
                          "value": "ATTACK (Player weak)",
                          "op": "set"
                        }
                      }
                    ],
                    "defaultAction": {
                      "action": "setGlobalVariable",
                      "variablePath": "user.persistent.battleAction",
                      "valueSource": "literal",
                      "value": "DEFEND (balanced state)",
                      "op": "set"
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
