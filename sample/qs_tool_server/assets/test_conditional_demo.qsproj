            {
              "id": "obj_compare_conditional",
              "name": "Compare Conditional",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "event_compare_test",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${user.persistent.hp}",
                          "operator": ">",
                          "right": 50
                        },
                        "action": {
                          "action": "setGlobalVariable",
                          "variablePath": "user.persistent.compareResult",
                          "valueSource": "literal",
                          "value": "PASS (hp=75 > 50)",
                          "op": "set"
                        }
                      }
                    ],
                    "defaultAction": {
                      "action": "setGlobalVariable",
                      "variablePath": "user.persistent.compareResult",
                      "valueSource": "literal",
                      "value": "FAIL",
                      "op": "set"
                    }
                  }
                }
              ]
            },
            {
              "id": "obj_equals_conditional",
              "name": "Equals Conditional",
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "event_equals_test",
                    "branches": [
                      {
                        "condition": {
                          "type": "equals",
                          "left": "${user.persistent.state}",
                          "right": "defending"
                        },
                        "action": {
