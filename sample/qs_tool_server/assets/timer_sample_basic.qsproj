            {
              "id": "obj_on_timer_trigger",
              "name": "OnTimerTrigger",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Trigger",
                  "enabled": true,
                  "data": {
                    "eventId": "ev_timer_3s",
                    "triggerOn": "onTimer",
                    "duration": 3,
                    "once": true,
                    "targetObjectId": ""
                  }
                }
              ]
            },
            {
              "id": "obj_on_update_trigger",
              "name": "OnUpdateTrigger",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Trigger",
                  "enabled": true,
                  "data": {
                    "eventId": "ev_frame_update",
                    "triggerOn": "onUpdate",
                    "once": false,
                    "targetObjectId": ""
                  }
                }
              ]
            },
            {
              "id": "obj_five_second_check",
              "name": "FiveSecondCheck",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_frame_update",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": {
                            "type": "globalVariable",
                            "path": "system.fixed.timer"
                          },
                          "operator": ">=",
                          "right": {
                            "type": "literal",
                            "value": 5
                          }
                        },
                        "eventId": "ev_timer_milestone_5s"
                      }
                    ],
                    "defaultAction": ""
                  }
                }
              ]
            }
          ]
        }
      ]
    }
