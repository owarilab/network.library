                }
              ]
            },
            {
              "id": "obj_on_timer_trigger",
              "name": "OnTimerTrigger",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Trigger",
                  "enabled": true,
                  "data": {
                    "eventId": "ev_timer_3s",
                    "triggerOn": "onTimer",
                    "duration": 3,
                    "once": true,
                    "targetObjectId": ""
                  }
                }
              ]
            },
            {
              "id": "obj_on_update_trigger",
              "name": "OnUpdateTrigger",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Trigger",
                  "enabled": true,
                  "data": {
                    "eventId": "ev_frame_update",
                    "triggerOn": "onUpdate",
                    "once": false,
                    "targetObjectId": ""
                  }
                }
              ]
            },
            {
              "id": "obj_five_second_check",
              "name": "FiveSecondCheck",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "Conditional",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_frame_update",
                    "branches": [
                      {
                        "condition": {
                          "type": "compare",
                          "left": "${system.fixed.timer}",
                          "operator": ">=",
                          "right": 5
                        },
                        "action": {
                          "action": "fireEvent",
                          "eventId": "ev_timer_milestone_5s"
                        }
                      }
                    ],
                    "defaultAction": ""
                  }
                }
              ]
            },
            {
              "id": "obj_timer_event_action",
              "name": "Timer Event Action",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_timer_3s",
                    "action": "setProperty",
                    "targetObjectId": "obj_timer_event_status",
                    "componentType": "Text",
                    "property": "text",
                    "value": "onTimer(3s): DONE"
                  }
                }
              ]
            },
            {
              "id": "obj_conditional_event_action",
              "name": "Conditional Event Action",
              "enabled": true,
              "parentId": "",
              "children": [],
              "components": [
                {
                  "type": "EventAction",
                  "enabled": true,
                  "data": {
                    "listenTo": "ev_timer_milestone_5s",
                    "action": "setProperty",
                    "targetObjectId": "obj_conditional_event_status",
                    "componentType": "Text",
                    "property": "text",
                    "value": "Conditional(timer >= 5): DONE"
                  }
                }
              ]
            }
          ]
        }
      ]
