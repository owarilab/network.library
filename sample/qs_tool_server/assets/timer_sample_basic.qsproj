                  "enabled": true,
                  "data": {
                    "x": 400,
                    "y": 250,
                    "z": 0,
                    "rotation": 0,
                    "scaleX": 1,
                    "scaleY": 1
                  }
                },
                {
                  "type": "Text",
                  "enabled": true,
                  "data": {
                    "text": "3秒後に上の行、5秒後に下の行が DONE へ変わります",
