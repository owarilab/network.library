/*
 * sample script
 * 各種ビルトイン（配列/ハッシュ・JSON・ファイル・乱数など）の動きをまとめて確認するサンプル
 */

// hash test: ハッシュとネストした配列を生成し、JSONエンコード／デコードを試す
config = [
    "port" : 8080,
    "maxcon" : 100,
    "objects" : [
        "obj1" : [
            "name" : "obj1_name",
            "value" : 1
        ],
        "obj2" : [
            "name" : "obj2_name",
            "value" : 2
        ]
    ],
    "int_array":[
        1,2,3,4
    ],
    "str_array":[
        "a","bb","cccc"
    ]
];

echo(json_decode(json));
echo(config);                      // ハッシュ全体をダンプ
json = json_encode(config);        // JSON文字列へ変換
echo(json + "\n");               // JSON文字列を出力
echo(json_decode(json));           // JSONをデコードして再びダンプ

test_obj = [];
test_obj["val"] = 1;
echo(test_obj);                    // 単純なハッシュ追加の例


is_enable=0;                       // trueにすると以下のwhile/ファイル操作テストが走る
if(is_enable)
{
    // while loop test
    cnt = rand() % 100;
    loopcnt=cnt;
    while(loopcnt>0){
        r = rand() % 10;
        echo("v = " + r + "\n");
        loopcnt--;
    }
    echo("cnt " + cnt + "\n");

    // file test
    file_name="hoge.txt";
    if(file_exist(file_name)){
        echo(file_name + " exist\n");
    }
    if(file_exist("aaaaaa.txt")){
    }else{
        echo("aaaaaa.txt not exist\n");
    }
    file_add(file_name,"aa");

    file_put("put.txt","t:" + gmtime());

    echo(gmtime() + "\n" );

    party = [100,200,300];
    len=count(party);             // 配列長取得

    echo("len = " + len + "\n");

    party[0] = 1231;
    party[1] = 1431;
    party[2] = 1931;

    i=0;
    while(i<len){
    echo( "v = " + party[i] + "\n" );
    i=i+1;
    }

    echo(json_encode(party)+"\n"); // 配列をJSONに変換

    i=0;
    while(i<1000){
    i=i+1;
    }

    result_html = make_html("<h1>sample</h1>"); // 簡易HTTPレスポンス文字列を生成
    echo (result_html);

    sample_func(i,"hoge");
}

/*
 * comment
 */
def sample_func(arg1, arg2)
{
    echo( "arg1=" + arg1 + " , arg2=" + arg2 + "\n" ); // 関数呼び出し例
}

/*
 * comment
 */
def hash_dump_test()
{
    hash=[ 
        "id" : "dummu_id",
        "params" : [30, 555],
        "arr" :[
                [
                    ["v1":1,"v2":2,"v3":3]
                ],
                [
                    [1,2,3]
                ]
            ]
        ];
    echo(json_encode(hash)+"\n");
    echo("hash value : " + hash["id"] + "\n");

    dec_hash=json_decode(json_encode(hash)); // encode→decode往復
    echo(dec_hash);

    hash2=["data":hash];
    echo(json_encode(hash2)+"\n");
}

/* html test: シンプルなHTTPレスポンス文字列を組み立てる */
def make_html(body)
{
    http_header="HTTP/1.1 200 OK
Content-Type: text/html
Connection: close

";

header="<html>
<head>

</head>
<body>
";

footer="
</body>
</html>
";

    html=http_header+header+body+footer;
    return html;
}

