// 配列要素の参照サンプル：int_arrayの3番目の値を取り出す
config = [
    "port" : 8080,
    "maxcon" : 100,
    "objects" : [
        "obj1" : [
            "name" : "obj1_name",
            "value" : 1
        ],
        "obj2" : [
            "name" : "obj2_name",
            "value" : 2
        ],
    ],
    "int_array":[
        1,2,3,4
    ],
    "str_array":[
        "a","bb","cccc"
    ]
];

temp_val = config["int_array"][2];
echo(temp_val);