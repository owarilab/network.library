// CSV読み込みと出力のサンプル
// - csv_read(file_path) でCSVを2次元配列として取得
// - csv_build(array[,bufsize]) で配列からCSV文字列を生成
// - csv_write(file_path, array[,bufsize]) でファイルに保存

// sample/csv/sample.csv を読み込み（実行ディレクトリは sample/script を想定）
csv_data = csv_read("../csv/sample.csv");

echo("[csv_read rows] " + count(csv_data) + "\n");
if(count(csv_data) > 0){
    echo("[first row] " + json_encode(csv_data[0]) + "\n");
}

// 配列をCSV文字列へ
csv_string = csv_build(csv_data);
echo("[csv_build]\n" + csv_string + "\n");

// ファイルへ書き出し
write_result = csv_write("tmp_sample.csv", csv_data);
echo("[csv_write] " + write_result + "\n");

// 日本語・カンマ・ダブルクオートを含むケースを読み込み（既知のパース不具合があるためデフォルト無効）
enable_jp = 0;
if(enable_jp){
    csv_jp = csv_read("../csv/sample_jp.csv");
    jp_rows = count(csv_jp);
    echo("[csv_read jp rows] " + jp_rows + "\n");
    if(jp_rows > 0){
        // 各行をJSONでダンプして、パース崩れを目視確認できるようにする
        i = 0;
        while(i < jp_rows){
            echo("[jp row " + i + "] " + json_encode(csv_jp[i]) + "\n");
            i = i + 1;
        }

        // 再度CSV文字列化して出力
        csv_jp_string = csv_build(csv_jp);
        echo("[csv_build jp]\n" + csv_jp_string + "\n");

        // 書き出し（サロゲート出力確認用）
        write_result_jp = csv_write("tmp_sample_jp.csv", csv_jp);
        echo("[csv_write jp] " + write_result_jp + "\n");
    }
}

// 配列をスクリプト内で組み立てて CSV 化するテスト（メモリ上のみ）
rows = [
    ["id","name","comment"],
    ["10","inline,comma","quoted ""text"""],
    ["11","日本語","メモ,カンマ"],
    ["12","empty",""],
];

csv_inline = csv_build(rows);
echo("[csv_build inline]\n" + csv_inline + "\n");
